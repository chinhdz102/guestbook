# Replace __IMAGE__ with your IBM Cloud registry image path before applying.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: guestbook
  annotations:
    kubernetes.io/change-cause: "Guestbook v2; CPU request 2m, limit 5m"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: guestbook
  template:
    metadata:
      labels:
        app: guestbook
    spec:
      containers:
        - name: guestbook
          image: __IMAGE__:v2
          ports:
            - containerPort: 3000
          resources:
            requests:
              cpu: 2m
            limits:
              cpu: 5m
